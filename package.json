{
  "name": "windows-voice-ai-agent",
  "version": "1.0.0",
  "description": "Real-time AI Voice Agent Desktop App for Windows - Real Estate Lead Qualification",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"vite\" \"cross-env NODE_ENV=development wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && npm run build:electron && electron-builder"
  },
  "keywords": [
    "ai",
    "voice-agent",
    "real-estate",
    "ollama",
    "electron",
    "react"
  ],
  "author": "Antigravity AI",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "wait-on": "^8.0.0"
  }
}
